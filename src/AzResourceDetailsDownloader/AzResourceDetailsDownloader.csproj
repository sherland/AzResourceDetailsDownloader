<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The composition root: wires Core (deterministic logic) and Infrastructure (real Azure/Playwright/
    terminal) together. Directly references Azure.Identity/Azure.ResourceManager itself (constructs
    ArmClient/AzureCliCredential here) — normal for a composition root, not a boundary violation the
    way it would be from inside Core.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzResourceDetailsDownloader.Core\AzResourceDetailsDownloader.Core.csproj" />
    <ProjectReference Include="..\AzResourceDetailsDownloader.Infrastructure\AzResourceDetailsDownloader.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Development.json')" />
  </ItemGroup>

</Project>
